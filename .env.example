# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="https://your-app-name.onrender.com"

# DATABASE / CLOUD STORAGE CONFIGURATION
# DB_PATH or DATABASE_URL: Specifies the path to the cloud SQLite database.
# On Render with a Persistent Disk mounted at /var/data, set DB_PATH=/var/data/pos.db
DB_PATH="/var/data/pos.db"
# DATABASE_URL="file:/var/data/pos.db"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="production"
