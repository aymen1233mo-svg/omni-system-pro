{
  "name": "omni-system-pro-erp",
  "version": "2.0.0",
  "description": "Omni System Pro ERP - Comprehensive Enterprise, Warehouse, POS, Sales & Accounting Management System",
  "author": "Omni System Pro ERP",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "install:all": "npm install",
    "postinstall": "node -e \"if (process.env.ELECTRON_BUILD === '1') { try { require('child_process').execSync('npx electron-rebuild -f -w better-sqlite3', { stdio: 'inherit' }); } catch(e){} }\"",
    "dev": "tsx server.ts",
    "build": "vite build && node -e \"const fs = require('fs'); if (fs.existsSync('dist/artifacts/pos-system/src/index.html')) { fs.copyFileSync('dist/artifacts/pos-system/src/index.html', 'dist/index.html'); }\" && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:electron",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "build:electron": "esbuild artifacts/pos-system/src/main/main.js --bundle --platform=node --format=cjs --external:electron --external:node:sqlite --outfile=electron-main.cjs && esbuild artifacts/pos-system/src/main/preload.js --bundle --platform=node --format=cjs --external:electron --outfile=preload.cjs",
    "electron:run": "npm run build && electron electron-main.cjs",
    "electron:package": "npm run build && npx electron-rebuild -f -w better-sqlite3 && electron-packager . \"OmniSystem_Pro_ERP\" --overwrite --out=dist-desktop --platform=win32 --arch=x64 --icon=public/omnisystem-logo.ico --ignore=\"(\\\\.npmignore|\\\\.gitignore|\\\\.git|/artifacts/pos-system/node_modules|/dist-desktop)\"",
    "electron:portable": "npm run build && npx electron-rebuild -f -w better-sqlite3 && electron-builder --win --x64 && node -e \"const fs = require('fs'); ['dist-desktop/win-unpacked', 'dist-desktop/win-unpacked.tmp', 'dist-desktop/builder-effective-config.yaml'].forEach(p => fs.rmSync(p, { recursive: true, force: true }));\""
  },
  "build": {
    "appId": "com.omnisystem.pro.erp",
    "productName": "OmniSystem_Pro_ERP",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "dist/**/*",
      "artifacts/api-server/data/**/*"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "icon": "public/omnisystem-logo.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "OmniSystem_Pro_ERP-win32-x64.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "artifacts/api-server/data/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^3.10.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.62.0",
    "@vitejs/plugin-react": "^5.0.4",
    "aria-hidden": "^1.2.6",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.25.0",
    "express": "^4.22.2",
    "framer-motion": "^11.11.17",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "qz-tray": "^2.2.6",
    "react": "^19.0.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vaul": "^1.1.2",
    "vite": "^6.2.3",
    "wouter": "^3.3.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.0",
    "@electron/rebuild": "^4.2.0",
    "@floating-ui/react-dom": "^2.1.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild-plugin-pino": "^2.3.3"
  }
}